<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd job for running vidsave persistently as your login user.

  Before installing, replace YOUR_USERNAME below with the output of `whoami`,
  and make sure the path matches where you actually put this folder.

    cp com.vidsave.local.plist ~/Library/LaunchAgents/
    launchctl load  ~/Library/LaunchAgents/com.vidsave.local.plist
    launchctl unload ~/Library/LaunchAgents/com.vidsave.local.plist   # to stop
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.vidsave.local</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/YOUR_USERNAME/vidsave/run.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/YOUR_USERNAME/vidsave</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- Homebrew on Apple Silicon is /opt/homebrew/bin; Intel is /usr/local/bin.
             launchd does not read your shell profile, so yt-dlp and ffmpeg must
             be findable here or every download will fail. -->
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/YOUR_USERNAME/Library/Logs/vidsave.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/YOUR_USERNAME/Library/Logs/vidsave.log</string>
</dict>
</plist>
