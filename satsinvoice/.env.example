# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://satsinvoice:satsinvoice@127.0.0.1:5432/satsinvoice?schema=public"
# Used only by `npm run test:db` (the Postgres-backed webhook tests).
TEST_DATABASE_URL="postgresql://satsinvoice:satsinvoice@127.0.0.1:5432/satsinvoice_test?schema=public"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public origin. Used to build payment links, webhook URLs and QR payloads.
APP_URL="http://localhost:3000"
# Auth.js session secret. Generate with: openssl rand -base64 32
AUTH_SECRET="dev-only-change-me-openssl-rand-base64-32"

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
# mock | opennode   (opennode is a stub in v1 — see src/lib/payments/opennode.ts)
PAYMENT_PROVIDER="mock"

# --- mock provider ---
# BTC price in USD the mock provider freezes onto new invoices.
MOCK_BTC_USD_RATE="65000"
# Shared secret the mock pay page signs its webhook calls with. Signature
# verification is SKIPPED when this is empty (see MOCK_SKIP_SIGNATURE below).
MOCK_WEBHOOK_SECRET="mock-webhook-secret"
# Set to "true" to accept unsigned mock webhooks (handy for curl / Postman).
MOCK_SKIP_SIGNATURE="true"

# --- opennode provider (not implemented in v1) ---
OPENNODE_API_KEY=""
OPENNODE_WEBHOOK_SECRET=""
